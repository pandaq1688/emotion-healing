/* pages/index/index.wxss */

.container {
  padding: 30rpx;
  background: #F7F3EE;
  min-height: 100vh;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #7A7A7A;
  margin-bottom: 24rpx;
}

/* 心情选择器 */
.mood-selector {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.mood-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #EEF4F8;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.mood-option.selected {
  border-color: #8BB8CC;
  background: rgba(139, 184, 204, 0.1);
}

.mood-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.mood-label {
  font-size: 24rpx;
  color: #7A7A7A;
}

/* 输入区 */
.input-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.mood-input {
  background: white;
  border: 2rpx solid #EDE6DF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  color: #3D3D3D;
}

/* 快捷标签 */
.quick-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-label {
  font-size: 24rpx;
  color: #A8A8A8;
  margin-right: 8rpx;
}

.tag {
  background: #EEF4F8;
  color: #7A7A7A;
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  border: none;
}

/* 结果区 */
.result-header {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.result-emoji {
  font-size: 48rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3D3D;
  margin-bottom: 4rpx;
}

.result-subtitle {
  font-size: 24rpx;
  color: #7A7A7A;
}

/* 歌曲列表 */
.songs-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.song-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
}

.song-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #B8D4E3, #8BB8CC);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: white;
  flex-shrink: 0;
}

.song-info {
  flex: 1;
  min-width: 0;
}

.song-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D3D3D;
  margin-bottom: 4rpx;
}

.song-artist {
  font-size: 24rpx;
  color: #A8A8A8;
}

.song-actions {
  display: flex;
  gap: 16rpx;
}

.heart-icon {
  font-size: 40rpx;
  line-height: 1;
}

.heart-icon.active {
  color: #FF6B6B;
  text-shadow: 0 0 8px rgba(255, 107, 107, 0.4);
}

.see-more {
  margin-top: 24rpx;
  padding: 16rpx;
  text-align: center;
  color: #7A7A7A;
  font-size: 24rpx;
  background: #EEF4F8;
  border-radius: 12rpx;
}

/* 书籍列表 */
.books-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.book-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.book-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #F5D6C6, #E8C4B2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.book-info {
  flex: 1;
  min-width: 0;
}

.book-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D3D3D;
  margin-bottom: 4rpx;
}

.book-author {
  font-size: 24rpx;
  color: #A8A8A8;
  margin-bottom: 12rpx;
}

.book-reason {
  background: #EEF4F8;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #F5D6C6;
  margin-bottom: 16rpx;
}

.book-reason text {
  font-size: 24rpx;
  color: #7A7A7A;
  line-height: 1.6;
}

.copy-btn {
  background: linear-gradient(135deg, #F5D6C6, #E8C4B2);
  color: #3D3D3D;
  border: none;
  border-radius: 12rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.book-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
}
