/* 情绪治愈馆小程序 - 全局样式 */

page {
  background-color: #F7F3EE;
  color: #3D3D3D;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4px 24px rgba(139, 184, 204, 0.15);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #B8D4E3, #8BB8CC);
  color: white;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
}

/* 文本样式 */
.text-primary {
  color: #3D3D3D;
}

.text-secondary {
  color: #7A7A7A;
}

.text-muted {
  color: #A8A8A8;
}

/* 布局样式 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.container {
  padding: 30rpx;
}

.mt-20 { margin-top: 20rpx; }
.mb-20 { margin-bottom: 20rpx; }
