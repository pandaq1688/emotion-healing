/* pages/record/record.wxss */

.container {
  padding: 30rpx;
  background: #F7F3EE;
  min-height: 100vh;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3D3D;
}

.clear-btn {
  font-size: 24rpx;
  color: #A8A8A8;
  padding: 8rpx 16rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #7A7A7A;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  display: block;
  font-size: 24rpx;
  color: #A8A8A8;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  border-left: 6rpx solid #8BB8CC;
}

.history-content {
  flex: 1;
  min-width: 0;
}

.history-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.history-emoji {
  font-size: 40rpx;
}

.history-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.history-mood {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D3D3D;
}

.history-category {
  font-size: 22rpx;
  color: white;
  padding: 4rpx 12rpx;
  background: #B8D4E3;
  border-radius: 20rpx;
}

.history-time {
  font-size: 22rpx;
  color: #A8A8A8;
}

.delete-btn {
  font-size: 32rpx;
  color: #C0392B;
  padding: 0 8rpx;
  line-height: 1;
}
